#!/usr/bin/env python3
import platform
import re
import subprocess
import time


def run(cmd):
    return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL).strip()


def memory():
    total = int(run("sysctl -n hw.memsize"))
    vm = run("vm_stat")
    page = int(re.search(r"page size of (\d+)", vm).group(1))
    pages = lambda k: int(re.search(rf"{k}:\s+(\d+)", vm).group(1))
    used = (pages("Pages active") + pages("Pages wired down") + pages("Pages occupied by compressor")) * page
    return f"{used / 2**30:.1f}G/{total / 2**30:.1f}G"


def uptime():
    boot = int(re.search(r"sec = (\d+)", run("sysctl -n kern.boottime")).group(1))
    s = int(time.time()) - boot
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return " ".join(p for p in (f"{d}d" if d else "", f"{h}h" if h else "", f"{m}m") if p)


def packages():
    try:
        return int(run("brew list | wc -l"))
    except subprocess.CalledProcessError:
        return 0


R = "\033[0m"
LOGO = [
    ("\033[92m", "        .:'"),
    ("\033[92m", "    __ :'__"),
    ("\033[93m", " .'`__`-'__``."),
    ("\033[38;5;208m", ":__________.-'"),
    ("\033[91m", ":_________:"),
    ("\033[95m", " :_________`-;"),
    ("\033[94m", "  `.__.-.__.'"),
]
rows = [
    ("\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500", None),
    ("\u2502", ("OS", f"macOS {platform.mac_ver()[0]}")),
    ("\u2502", ("Kernel", platform.release())),
    ("\u2502", ("Packages", packages())),
    ("\u2502", ("Memory", memory())),
    ("\u2502", ("Uptime", uptime())),
    ("\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500", None),
]

print()
for (color, art), (border, item) in zip(LOGO, rows):
    text = f"{color}{border}{R} {color}{item[0]}{R}\u203a {item[1]}" if item else f"{color}{border}{R}"
    print(f"{color}{art.ljust(17)}{R}{text}")
print()
